{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sagas": ""
  },
  "NativeOrchestrator": {
    "WorkerEnabled": true,
    "MaxConcurrency": 16,
    "ScanInterval": "00:00:05",
    "LeaseDuration": "00:05:00",
    "LeaseRenewalInterval": "00:01:00",
    "SqlServer": {
      "CommandTimeout": "00:00:30",
      "MaxRetryCount": 6,
      "MaxRetryDelay": "00:00:30",
      "UseLockingClaim": true,
      "ApplyMigrationsOnStartup": false
    },
    "SagaDefaults": {
      "MaxDuration": "7.00:00:00",
      "StepTimeout": "1.00:00:00",
      "ExecutionTimeout": "00:02:00",
      "Retry": {
        "MaxAttempts": 8,
        "InitialDelay": "00:00:10",
        "MaxDelay": "00:15:00",
        "Multiplier": 2,
        "UseJitter": true
      },
      "Polling": {
        "InitialDelay": "00:00:30",
        "MaxDelay": "00:10:00",
        "Multiplier": 1.5
      }
    },
    "Sagas": {
      "customer-onboarding": {
        "MaxDuration": "3.00:00:00",
        "Steps": {
          "VerifyIdentity": {
            "Polling": {
              "InitialDelay": "00:01:00",
              "MaxDelay": "00:30:00",
              "Multiplier": 2
            }
          }
        }
      },
      "report-generation": {
        "MaxDuration": "3.00:00:00",
        "Steps": {
          "GenerateReport": {
            "Polling": {
              "InitialDelay": "00:05:00",
              "MaxDelay": "01:00:00",
              "Multiplier": 2
            }
          }
        }
      }
    }
  },
  "Resilience": {
    "AttemptTimeout": {
      "Timeout": "00:00:10"
    },
    "TotalRequestTimeout": {
      "Timeout": "00:00:30"
    },
    "Retry": {
      "MaxRetryAttempts": 3,
      "Delay": "00:00:00.500"
    }
  },
  "ExternalServices": {
    "Identity": "http://localhost:5080/simulated/identity/",
    "Accounts": "http://localhost:5080/simulated/",
    "Notifications": "http://localhost:5080/simulated/notifications/",
    "Reports": "http://localhost:5080/simulated/"
  },
  "Simulated": {
    "Enabled": true,
    "IdentityCheckDuration": "00:00:10",
    "RetryAfter": "00:00:02"
  }
}
