{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sagas": ""
  },
  "SagaOrchestrator": {
    "WorkerEnabled": true,
    "MaxConcurrency": 16,
    "ScanInterval": "00:00:05",
    "LeaseDuration": "00:05:00",
    "LeaseRenewalInterval": "00:01:00",
    "SqlServer": {
      "CommandTimeout": "00:00:30",
      "MaxRetryCount": 6,
      "MaxRetryDelay": "00:00:30",
      "UseLockingClaim": true,
      "ApplyMigrationsOnStartup": false
    },
    "SagaDefaults": {
      "MaxDuration": "7.00:00:00",
      "StepTimeout": "1.00:00:00",
      "ExecutionTimeout": "00:02:00",
      "Retry": {
        "MaxAttempts": 8,
        "InitialDelay": "00:00:10",
        "MaxDelay": "00:15:00",
        "Multiplier": 2,
        "UseJitter": true
      },
      "Polling": {
        "InitialDelay": "00:00:30",
        "MaxDelay": "00:10:00",
        "Multiplier": 1.5
      }
    },
    "Sagas": {
      "client": {
        "MaxDuration": "1.00:00:00",
        "StepTimeout": "06:00:00",
        "Polling": {
          "InitialDelay": "00:01:00",
          "MaxDelay": "00:15:00",
          "Multiplier": 1.5
        }
      }
    }
  },
  "ApiManagement": {
    "MaxDuration": "00:00:20"
  }
}
